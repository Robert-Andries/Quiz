{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "QuizDatabase": "Server=database,1433;Database=Questions;User Id=sa;Password=Password123!;TrustServerCertificate=True;"
  },
  "QuizSettings": {
    "NumberOfQuestions": 2,
    "MaxNumberOfWrongAnswers": 1
  },
  "AllowedHosts": "*",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "RealUpHeader": "X-Real-IP",
    "HttpStatusCode": 429,
    "IpWhitelist": [],
    "EndpointWhitelist": [],
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 10
      }
    ]
  }
}